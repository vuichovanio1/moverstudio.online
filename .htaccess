# ========================================
# MOVER Studio - moverstudio.online
# Optimized .htaccess for cPanel & Social Sharing
# ========================================

# Enable RewriteEngine
RewriteEngine On

# Ignore byte-range requests (Apache; LiteSpeed ignores this for static files)
RewriteCond %{HTTP:Range} .+
RewriteRule .* - [E=HTTP_RANGE:,E=HTTP_IF_RANGE:]

# LiteSpeed returns 206 for static files with Range — always serve OG image via PHP (200 OK)
RewriteRule ^og-image\.(png|jpe?g)$ og-image.php [L,QSA]
RewriteRule ^og-image-small\.png$ og-image.php [L,QSA]

# ----------------------------------------
# 1–2. Single-hop canonical: HTTPS + non-www
# ----------------------------------------
# http://www → https://apex (one hop)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^www\.moverstudio\.online$ [NC]
RewriteRule ^ https://moverstudio.online%{REQUEST_URI} [L,R=301]

# http://apex → https://apex
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# https://www → https://apex
RewriteCond %{HTTP_HOST} ^www\.moverstudio\.online$ [NC]
RewriteRule ^ https://moverstudio.online%{REQUEST_URI} [L,R=301]

# Redirect old Sofia slug to the new singular URL
RewriteRule ^izrabotka-na-saitove-sofia\.html$ /izrabotka-na-sait-sofia.html [L,R=301]

# Redirect removed URLs to their canonical replacements
RewriteRule ^dokazatelstva\.html$ /case-studies.html [L,R=301]
RewriteRule ^pagespeed-100-html\.html$ /html-sait.html [L,R=301]

# ----------------------------------------
# SEO / log-driven redirects (404 → canonical)
# ----------------------------------------

# Trailing-dot typos: /page.html. → /page.html
RewriteRule ^(.+)\.$ /$1 [L,R=301]

# Common English/path expectations
RewriteRule ^about/?$ /about.html [L,R=301]
RewriteRule ^about-us/?$ /about.html [L,R=301]
RewriteRule ^contact/?$ /#contact [L,R=301,NE]
RewriteRule ^contact-us/?$ /#contact [L,R=301,NE]

# Blog posts requested without /blog/ prefix (access-log 404s)
RewriteRule ^wordpress-malak-biznes-2026\.html$ /blog/wordpress-malak-biznes-2026.html [L,R=301]
RewriteRule ^migratsiya-wordpress-kam-html-2026\.html$ /blog/migratsiya-wordpress-kam-html-2026.html [L,R=301]
RewriteRule ^multi-location-seo-html-2026\.html$ /blog/multi-location-seo-html-2026.html [L,R=301]
RewriteRule ^5-prichini-da-napusnesh-wordpress-dnes\.html$ /blog/5-prichini-da-napusnesh-wordpress-dnes.html [L,R=301]
RewriteRule ^zashto-wordpress-e-baven\.html$ /blog/zashto-wordpress-e-baven.html [L,R=301]
RewriteRule ^sait-vizitka-portfolio-malk-biznes-2026\.html$ /blog/sait-vizitka-portfolio-malk-biznes-2026.html [L,R=301]
RewriteRule ^baven-lending-krade-ads-byudzhet-2026\.html$ /blog/baven-lending-krade-ads-byudzhet-2026.html [L,R=301]
RewriteRule ^landing-page-google-ads-facebook-2026\.html$ /blog/landing-page-google-ads-facebook-2026.html [L,R=301]
RewriteRule ^kolko-struva-izrabotka-na-sait-2026\.html$ /blog/kolko-struva-izrabotka-na-sait-2026.html [L,R=301]
RewriteRule ^korporativen-sait-vs-vizitka-2026\.html$ /blog/korporativen-sait-vs-vizitka-2026.html [L,R=301]
RewriteRule ^html-saitove-google-search-console-2026\.html$ /blog/html-saitove-google-search-console-2026.html [L,R=301]

# Broken tel:/viber: links incorrectly requested as paths
RewriteCond %{THE_REQUEST} \s/+tel:
RewriteRule ^ /#contact [L,R=301,NE]
RewriteCond %{THE_REQUEST} \s/+viber:
RewriteRule ^ /#contact [L,R=301,NE]

# ----------------------------------------
# 3. Custom Error Pages
# ----------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------
# 4. Security Headers (Social Media Friendly)
# ----------------------------------------
<IfModule mod_headers.c>
  # CSP: Разрешаваме img-src https: за Facebook/Messenger ботовете
  Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Предотвратява MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Защита от clickjacking
  Header set X-Frame-Options "DENY"

  # HSTS
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Cross-Origin Policies - Оправени за Messenger преглед
  Header set Cross-Origin-Opener-Policy "unsafe-none"
  Header unset Cross-Origin-Embedder-Policy

  # Контрол на референтната информация
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy (disable unused powerful APIs)
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"

  # Фикс за грешка 206 (Partial Content)
  Header set Accept-Ranges none

  # DNS Prefetch
  Header set X-DNS-Prefetch-Control "on"

  # LLMs.txt header for AI discovery
  Header set X-LLMS-TXT "/llms-full.txt"
</IfModule>

# OG image: drop HTML-only headers; KEEP HSTS on all HTTPS responses
<Files "og-image.php">
  <IfModule mod_headers.c>
    Header always unset Content-Security-Policy
    Header always unset X-Frame-Options
    Header always unset Referrer-Policy
    Header always unset Cross-Origin-Opener-Policy
    Header always unset X-LLMS-TXT
    Header always unset X-Content-Type-Options
    Header always unset Permissions-Policy
  </IfModule>
</Files>

# ----------------------------------------
# 5. MIME Types
# ----------------------------------------
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType text/xml .xml
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/x-icon .ico
  AddType application/trafficadvice+json traffic-advice
</IfModule>

# Chrome Privacy Sandbox / prefetch proxy
<IfModule mod_headers.c>
  <Files "traffic-advice">
    Header set Content-Type "application/trafficadvice+json"
    Header set Cache-Control "public, max-age=86400"
  </Files>
</IfModule>

# ----------------------------------------
# 6. Compression (Gzip + optional Brotli)
# ----------------------------------------
<IfModule mod_deflate.c>
  # Max zlib level when supported (Apache 2.4+ / LiteSpeed)
  DeflateCompressionLevel 9
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/trafficadvice+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  # Skip recompressing already-compressed binary assets
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|woff2|ico)$ no-gzip dont-vary
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# Brotli when available (cPanel/LiteSpeed/OpenLiteSpeed)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/ld+json application/xml application/trafficadvice+json image/svg+xml
  BrotliCompressionQuality 6
</IfModule>

# ----------------------------------------
# 7. Browser Caching
# ----------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ----------------------------------------
# LLMs.txt File Configuration
# ----------------------------------------
<Files "llms-full.txt">
    ForceType text/plain
    Header set Cache-Control "public, max-age=3600"
</Files>

# ----------------------------------------
# 8. ETag (използваме само Expires за по-бърз PageSpeed)
# ----------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# ----------------------------------------
# 9. Забрана на листване на директории
# ----------------------------------------
Options -Indexes

# ----------------------------------------
# 10. Блокиране на достъп до системни файлове
# ----------------------------------------
<FilesMatch "(^\.htaccess|_headers|\.git|\.bak|bak-pre-)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Block backup HTML by exact name
<Files "index.html.bak-pre-redesign">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# ----------------------------------------
# 11. Фикс за началната страница, блога и services
# ----------------------------------------

# Уверяваме се, че коренът зарежда главния файл
DirectoryIndex index.html

# Strip trailing slash after .html (e.g. /about.html/ → /about.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+\.html)/$ /$1 [L,R=301]

# Пренасочваме /blog и /services към trailing-slash каноникал
RewriteCond %{REQUEST_URI} ^/blog$ [NC]
RewriteRule ^ /blog/ [L,R=301]
RewriteCond %{REQUEST_URI} ^/services$ [NC]
RewriteRule ^ /services/ [L,R=301]
